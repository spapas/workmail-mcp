# Mailbox connection (IMAPS only)
WORKMAIL_IMAP_HOST=imap.example.invalid
WORKMAIL_IMAP_PORT=993
WORKMAIL_IMAP_USERNAME=user@example.invalid
# Set exactly one password source. Prefer *_FILE on a real machine.
WORKMAIL_IMAP_PASSWORD=
WORKMAIL_IMAP_PASSWORD_FILE=C:\\path\\to\\secrets\\imap-password.txt

# HTTP MCP mode. Only numeric loopback IPs are accepted.
WORKMAIL_HTTP_ADDR=127.0.0.1:8787
# Set exactly one token source. Generate with: workmail-mcp.exe token
WORKMAIL_API_TOKEN=
WORKMAIL_API_TOKEN_FILE=C:\\path\\to\\secrets\\api-token.txt

# Mail behavior and safety limits
WORKMAIL_DEFAULT_FOLDER=INBOX
WORKMAIL_MAX_RESULTS=50
WORKMAIL_MAX_QUERY_LENGTH=512
WORKMAIL_MAX_MESSAGE_BYTES=26214400
WORKMAIL_MAX_BODY_BYTES=524288
WORKMAIL_MAX_ATTACHMENT_BYTES=10485760
WORKMAIL_MAX_THREAD_MESSAGES=50
WORKMAIL_OPERATION_TIMEOUT=30s
